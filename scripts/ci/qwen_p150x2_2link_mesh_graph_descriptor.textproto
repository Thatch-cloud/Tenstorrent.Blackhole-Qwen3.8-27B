# Two p150a cards opened as one (1, 2) mesh (the TP2 pair) on a cabling that trains 2 links per pair.
# Upstream p150_x2 declares 4 channels; STRICT_INIT refuses an edge that trains fewer than declared.

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 1, 2 ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
