# A committed TEMPLATE of .github/c2-serving-job.env (scripts/ci/c2_serving_job.py parses it).
# Eight-user coding baseline for the target (8 standard seats): the opt-in concurrent8_code test (2 x 4k/8k/16k/24k real-code
# prompts, 800 out, started together) beside concurrent4_code on the same image.
# E5: G1 with prefix reuse (general-prefix-tp4, 8 seats): all eight decode at once. ~20 min.
C2_CARDS=quad
C2_ACTIONS=reset smoke
C2_IMAGE_TAG=tp4-freeze-1
C2_PROFILE=general-prefix-tp4
C2_SMOKE_TESTS=warmup,coding,concurrent4_code,concurrent8_code
