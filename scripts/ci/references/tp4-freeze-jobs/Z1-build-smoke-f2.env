# A committed TEMPLATE of .github/c2-serving-job.env (scripts/ci/c2_serving_job.py parses it) for the admission-freeze arms.
# Like-for-like with tonight's T1 (tp4-serve-3, c2-packed-tp4: audits on + tail caps): the same smoke list, coding tests included,
# measured client-side; the twins differ from c2-packed-tp4 only by the F2 / F1 flags.
# Z1: build tp4-freeze-1 and smoke c2-packed-tp4-f2 (F2: admission diagnostics trimmed). Duration ~45 min.
C2_CARDS=quad
C2_ACTIONS=status reset build smoke
C2_IMAGE_TAG=tp4-freeze-1
C2_PROFILE=c2-packed-tp4-f2
C2_SMOKE_TESTS=warmup,coding,long_real_text,concurrent4,concurrent4_steady,steady_resend,tool_call,stream_tool_call,stream_reasoning,refused_n2,alive_after_refusal,stream_dropped,alive_after_drop,concurrent4_solo,concurrent4_code,concurrent4_code_equal
