+CPUS_MAX = 64
+CPUSET = re.compile(r'^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$')
+CPU_SHARES_RANGE = (2, 262144)
+
+
+def read_cpu_placement(values, actions, cards):
+    """(cpus, cpuset, cpu_shares) of C2_CPUS, C2_CPUSET and C2_CPU_SHARES (module docstring) as strings the smoke step hands docker, '' for each that is unset, or JobError. Only the
+    four-card smoke action takes them: a job without it would silently run at the default placement."""
+    cpus = values.get('C2_CPUS', '').strip()
+    cpuset = values.get('C2_CPUSET', '').strip()
+    shares = values.get('C2_CPU_SHARES', '').strip()
+    if not (cpus or cpuset or shares):
+        return '', '', ''
+    if 'smoke' not in actions or cards != 'quad':
+        raise JobError('C2_CPUS, C2_CPUSET and C2_CPU_SHARES place the four-card smoke container: C2_ACTIONS needs smoke and C2_CARDS=quad')
+    if cpus and cpus != 'none':
+        count = positive_int('C2_CPUS', cpus)
+        if count > CPUS_MAX:
+            raise JobError('C2_CPUS must be at most %d or none, got %d' % (CPUS_MAX, count))
+        cpus = str(count)
+    if cpuset and not CPUSET.match(cpuset):
+        raise JobError('C2_CPUSET must be a CPU list such as 0-15,32-47, got %r' % cpuset)
+    if shares:
+        count = positive_int('C2_CPU_SHARES', shares)
+        if not CPU_SHARES_RANGE[0] <= count <= CPU_SHARES_RANGE[1]:
+            raise JobError('C2_CPU_SHARES must be %d..%d, got %d' % (CPU_SHARES_RANGE[0], CPU_SHARES_RANGE[1], count))
+        shares = str(count)
+    return cpus, cpuset, shares
+
