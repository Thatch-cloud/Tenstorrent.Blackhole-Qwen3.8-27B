@@ -804,6 +804,45 @@ class BoxTests(unittest.TestCase):
         self.assertIsNone(job.PROFILE_NAME.fullmatch('c2' * 40))
 
 
+class CpuPlacementTests(unittest.TestCase):
+    """C2_CPUS, C2_CPUSET, C2_CPU_SHARES: the CPU placement of the four-card smoke container (the host-gap package's scheduler experiment); unset is today's `--cpus 8`."""
+
+    SMOKE = dict(C2_ACTIONS='reset smoke', C2_CARDS='quad')
+
+    def test_unset_is_empty_and_each_key_is_passed_through_validated(self):
+        none = box(**self.SMOKE)
+        self.assertEqual((none['cpus'], none['cpuset'], none['cpu_shares']), ('', '', ''))
+        placed = box(C2_CPUS=' 16 ', C2_CPUSET='0-15,32-47', C2_CPU_SHARES='262144', **self.SMOKE)
+        self.assertEqual((placed['cpus'], placed['cpuset'], placed['cpu_shares']), ('16', '0-15,32-47', '262144'))
+        self.assertEqual(box(C2_CPUS='none', **self.SMOKE)['cpus'], 'none')
+        self.assertEqual(box(C2_CPUSET='3', **self.SMOKE)['cpuset'], '3')
+
+    def test_a_bad_value_or_a_job_without_the_four_card_smoke_is_refused(self):
+        for values in (dict(C2_CPUS='0'), dict(C2_CPUS='65'), dict(C2_CPUS='eight'), dict(C2_CPUS='8.5'), dict(C2_CPUSET='0-15,'), dict(C2_CPUSET='a'), dict(C2_CPUSET='0 15'),
+                       dict(C2_CPU_SHARES='1'), dict(C2_CPU_SHARES='262145'), dict(C2_CPU_SHARES='x')):
+            with self.subTest(values=values), self.assertRaises(job.JobError):
+                box(**dict(self.SMOKE, **values))
+        for actions in (dict(C2_ACTIONS='reset', C2_CARDS='quad'), dict(C2_ACTIONS='reset smoke', C2_CARDS='pair'), dict(C2_ACTIONS='reset gate', C2_CARDS='quad')):
+            with self.subTest(actions=actions), self.assertRaises(job.JobError):
+                box(C2_CPUS='16', **actions)
+        with self.assertRaises(job.JobError) as raised:
+            box(C2_CPUS='16', C2_ACTIONS='reset', C2_CARDS='quad')
+        self.assertIn('four-card smoke', str(raised.exception))
+
+    def test_the_smoke_step_places_the_container_with_the_keys_and_keeps_today_when_they_are_unset(self):
+        text = step_text('Smoke on the four-card set')
+        script = step_script('Smoke on the four-card set')
+        for name in ('cpus', 'cpuset', 'cpu_shares'):
+            self.assertIn('${{ steps.job.outputs.%s }}' % name, text)
+        self.assertIn('cpu_args=(--cpus "${CPUS:-8}")', script)
+        self.assertIn('if [ "$CPUS" = none ]; then cpu_args=(); fi', script)
+        self.assertIn('--cpuset-cpus "$CPUSET"', script)
+        self.assertIn('--cpu-shares "$CPU_SHARES"', script)
+        self.assertIn('${cpu_args[@]+"${cpu_args[@]}"}', script)
+        self.assertNotIn('--memory 80g --cpus 8', script, 'the quota is no longer hard-coded in the four-card smoke')
+        self.assertEqual(step_script('Smoke on cards M+A').count('--memory 80g --cpus 8'), 1, 'the pair smoke is untouched')
+
+
 class BoxWorkflowTests(unittest.TestCase):
