+def _ccl_links(env, default):
+    """CCL link count, overridable per call-site. Announces itself when overridden.
+
+    Upstream hardcodes these; with 2 QSFP-DD cables the fabric offers 4 links per hop
+    and the p150_x2 descriptor exposes them, but nothing in the model asks for more
+    than it was written for. See tt_ccl.get_num_links() for the principled version."""
+    v = int(os.environ.get(env) or default)
+    if v != default:
+        print(f"[CCL_LINKS] {env}={v} (upstream default {default})", flush=True)
+    return v
+
