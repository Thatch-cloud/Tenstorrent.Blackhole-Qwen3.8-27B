+    def _shard_greedy_reduce(self, sharded_logits):
+        """Per-device argmax+max over this device's vocab shard -> [1,1,2,B] fp32.
+
+        Mirrors the demo's "shard" batched-decode mode (text_demo.py _argmax_dev_b /
+        _maxval_dev_b), which is byte-identical to host argmax over the gathered vocab.
+        All ops are device ops so this is safe to capture inside the decode trace.
+        """
+        B = sharded_logits.shape[2]
+        per_shard = sharded_logits.shape[3]
+        C = 32
+        R = (((per_shard + C - 1) // C) + 31) // 32 * 32
+
+        rm = ttnn.to_layout(sharded_logits, ttnn.ROW_MAJOR_LAYOUT)
+        idx = ttnn.argmax(rm, dim=-1, keepdim=False)           # [1,1,B] int32
+        ttnn.deallocate(rm)
+
+        padded = ttnn.pad(sharded_logits, [(0, 0), (0, 0), (0, 0), (0, R * C - per_shard)], value=-1e30)
+        grid = ttnn.reshape(padded, (1, B, R, C))
+        part = ttnn.max(grid, dim=-1)
+        part_row = ttnn.reshape(part, (1, 1, B, R))
+        val = ttnn.max(part_row, dim=-1)                        # [1,1,B]
+        for t in (padded, grid, part, part_row):
+            ttnn.deallocate(t)
+
+        # argmax requires (and returns) ROW_MAJOR; max returns TILE. ttnn.concat rejects
+        # mixed layouts, so bring the index side to TILE before combining.
+        idx_t = ttnn.to_layout(ttnn.reshape(idx, (1, 1, 1, B)), ttnn.TILE_LAYOUT)
+        val_t = ttnn.reshape(val, (1, 1, 1, B))
+        if val_t.layout != ttnn.TILE_LAYOUT:
+            val_t = ttnn.to_layout(val_t, ttnn.TILE_LAYOUT)
+        idx_f = ttnn.typecast(idx_t, ttnn.float32)
+        val_f = ttnn.typecast(val_t, ttnn.float32)
+        out = ttnn.concat([idx_f, val_f], dim=2)                # [1,1,2,B]
+        for t in (idx, val, idx_t, val_t, idx_f, val_f):
+            try:
+                ttnn.deallocate(t)
+            except Exception:
+                pass
+        if not getattr(self, "_shard_greedy_logged", False):
+            self._shard_greedy_logged = True
+            print(
+                f"QWEN36_SHARD_GREEDY engaged: per-shard argmax in-trace, B={B}"
+                f" per_shard={per_shard} -> {list(out.shape)}",
+                flush=True,
+            )
+        return out
+
