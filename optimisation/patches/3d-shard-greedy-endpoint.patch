+class _ShardGreedySampler:
+    """Greedy-only stand-in for SamplingGenerator (optimisation-plan row 3d).
+
+    TP=2 puts 124,160 logits on each device, over the multi-device TopK kernel ceiling
+    of 65,536, so the real sampler cannot be built and the endpoint gathers the full
+    vocab to host every step. This object satisfies the Generator sampling contract so
+    the on-device path is taken, while the work is done by Model._shard_greedy_reduce
+    inside the decode trace: each device argmaxes its OWN vocab shard and returns
+    [1,1,2,B] fp32 (idx row, val row); the winning device per user is picked on host in
+    process_output_decode from 2*2*B floats. No collective, no sampling trace. Greedy
+    only: temperature>0 requests get argmax (warned once). QWEN36_SHARD_GREEDY=1 enables.
+    """
+
+    def __init__(self, args):
+        # The Generator asserts the sampling width is a multiple of 32 (the real sampler
+        # always runs >=32 wide); the value only sizes host-side param chunks here.
+        width = max(32, -(-args.max_batch_size // 32) * 32)
+        self.tt_sampling = _ShardGreedyTT(width)
+        self.seed_manager = _ShardGreedySeeds(width)
+        self._warned = False
+
+    def set_trace_bucket(self, bucket):
+        pass
+
+    def reset_trace(self):
+        pass
+
+    def apply_prefill_state(self, *a, **k):
+        pass
+
+    def apply_decode_state(self, sampling_params_chunks, *, reset_batch=False, prompt_tokens=None, output_tokens=None):
+        if self._warned:
+            return
+        for sp in sampling_params_chunks:
+            t = getattr(sp, "temperature", 0)
+            ts = list(t) if isinstance(t, (list, tuple)) else [t]
+            if any((x or 0) > 0 for x in ts):
+                self._warned = True
+                logger.warning("QWEN36_SHARD_GREEDY: temperature>0 requested; shard-greedy always returns argmax")
+                return
+
+    def capture_trace(self, logits, *, tt_out_tok=None, skip_precompile=False):
+        return logits  # the reduce already lives inside the decode trace
+
+    def sample(self, logits, *, enable_trace=True, tt_out_tok=None, skip_precompile=False):
+        return logits  # [1,1,2,B] per-shard (idx, val); winner picked in process_output_decode
