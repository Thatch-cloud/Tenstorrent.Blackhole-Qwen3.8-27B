+def _cores(env, default):
+    """num_cores for a 1D decode matmul, overridable for sweeps.
+
+    The literals below were tuned on P150x4 (see the wide1d_* comments). At TP=2 each
+    device holds twice the weight per matmul, so the optimum may differ. Announces
+    itself whenever it differs from the tuned default."""
+    import os as _o
+    v = int(_o.environ.get(env) or default)
+    if v != default:
+        print(f"[MM_CORES] {env}={v} (tuned default {default})", flush=True)
+    return v
+
