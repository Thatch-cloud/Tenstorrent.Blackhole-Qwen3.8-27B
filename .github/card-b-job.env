# The card-B job that the next experiment/card-b-vN tag runs (.github/workflows/qwen-card-b.yml).
# CARD_B_HARNESS: a card-B runner script that uses the qual_card board selection, relative to the repo root.
# CARD_B_ARGS: extra harness arguments (the harnesses read CARD_B_ARGS).
# CARD_B_ENV: extra environment, space-separated NAME=value (never QUAL_CARD, ALLOW_SERVING_CARD or RESULTS).
CARD_B_HARNESS=optimisation/ttnn-op/k64j/build_k64j.sh
CARD_B_ARGS=
CARD_B_ENV=K64J_BASE_GRAFT=/home/thatch/opgraft-K64i K64J_GRAFT=/home/thatch/opgraft-K64j K64J_DECODE_BASE_DIR=/home/thatch/kwork64/k64f K64J_PF_BASE_DIR=/home/thatch/kwork64/k64g K64J_WORK_ROOT=/home/thatch/kwork64/k64j
