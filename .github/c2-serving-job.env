# The job the next experiment/c2-serving-vN tag runs (.github/workflows/qwen-c2-serving.yml).
# C2_ACTIONS: any of status platform unserve priority reset build smoke replay push, in that order.
# C2_IMAGE_TAG: the image is zot.thatch.local:5000/tt-vllm:qwen38-c2-<tag>.
# C2_PROFILE: general, exact or coding (scripts/ci/qwen_c2_profiles.json); smoke only.
# C2_SMOKE_TESTS: comma-separated subset of scripts/ci/c2_serving_smoke.py's tests, or empty for all.
C2_ACTIONS=metering
C2_IMAGE_TAG=v7-ab
C2_PROFILE=general-p300-lean
C2_SMOKE_TESTS=warmup,coding,concurrent4
# C2_PLATFORM_IMAGE: the thatch-serving-tt image the replay action runs (Thatch.Server tt-serving-image.yml output).
C2_PLATFORM_IMAGE=zot.thatch.local:5000/thatch-serving-tt@sha256:cbadfce6ea15944ab82958401db71c096847bbc6dd57909410a56b8aed544fea
# C2_SMOKE_IMAGE: run the smoke on this image instead of the C2 base (e.g. a thatch-serving-tt tag on the rig).
C2_SMOKE_IMAGE=zot.thatch.local:5000/thatch-serving-tt:863112a
