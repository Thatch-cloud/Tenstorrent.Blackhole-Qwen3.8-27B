 }
 
+// The same refusal for p2pmem (published slices of BAR4 that an NVMe drive may be writing into),
+// but held for the whole reset: checking and then letting go would leave a window in which a
+// process could map the slice and start a DMA while the ASIC resets. While the slice is held,
+// p2pmem/allocate gives ENOMEM.
+static long ioctl_reset_device(struct chardev_private *priv,
+			       struct tenstorrent_reset_device __user *arg)
+{
+	struct tenstorrent_device *tt_dev = priv->device;
+	struct tenstorrent_reset_device_in in;
+	void *p2pmem_hold = NULL;
+	long ret;
+
+	memset(&in, 0, sizeof(in));
+	if (copy_from_user(&in, &arg->in, sizeof(in)) != 0)
+		return -EFAULT;
+
+	if (reset_flags_destructive(in.flags) && tt_p2pmem_hold(tt_dev, &p2pmem_hold))
+		return -EBUSY;
+
+	ret = do_reset_device(priv, arg);
+
+	tt_p2pmem_release(tt_dev, p2pmem_hold);
+	return ret;
+}
