+// SPDX-FileCopyrightText: © 2026 Tenstorrent Inc.
+// SPDX-License-Identifier: GPL-2.0-only
+
+#ifndef TTDRIVER_P2PMEM_H_INCLUDED
+#define TTDRIVER_P2PMEM_H_INCLUDED
+
+#include <linux/types.h>
+#include <linux/mutex.h>
+
+struct tenstorrent_device;
+
+// State of the optional PCI peer-to-peer memory (p2pmem) slice of a device's BAR.
+// Everything here is written once at probe, before the sysfs group is added.
+struct tt_p2pmem {
+	bool published;		// pci_p2pdma_add_resource() succeeded; set last, with release semantics, after the fields below
+	bool group_registered;	// the "p2pmem" sysfs group is on tt_dev->dev
+	int bar;
+	u64 offset;		// byte offset of the slice inside the BAR
+	u64 size;		// slice length in bytes
+	u64 bus_addr;		// PCI bus address of the first byte of the slice
+	int tlb_first;		// first inbound TLB window overlapping the slice, or -1
+	int tlb_last;		// last such window, or -1
+};
+
+// Publish the configured slice of the device's BAR as p2pmem, if the p2pmem_devices
+// module parameter names this device. Never fatal: a failure is logged and the device
+// carries on without p2pmem. Call after the device is registered.
+void tt_p2pmem_probe(struct tenstorrent_device *tt_dev);
+
+// Remove the sysfs group. The pages themselves are devm-managed by the PCI core and go
+// away when the driver unbinds from the device.
+void tt_p2pmem_remove(struct tenstorrent_device *tt_dev);
+
+// Take the whole slice, so that nothing can be allocated from it (no new mapping of
+// p2pmem/allocate, no in-kernel user) until tt_p2pmem_release(). 0 on success, with
+// *cookie NULL when nothing is published; -EBUSY when any part of the slice is allocated
+// (mapped by userspace or in use by a DMA). A device reset while the slice is allocated
+// can wedge the host, so the reset ioctl holds it for the length of the reset.
+int tt_p2pmem_hold(struct tenstorrent_device *tt_dev, void **cookie);
+void tt_p2pmem_release(struct tenstorrent_device *tt_dev, void *cookie);
+
+// True while any part of the slice is allocated. A momentary hold: a concurrent
+// allocation can see ENOMEM once.
+bool tt_p2pmem_busy(struct tenstorrent_device *tt_dev);
+
+#endif // TTDRIVER_P2PMEM_H_INCLUDED
