new file mode 100644
index 0000000..42d8c00
--- /dev/null
+++ b/p2pmem.c
@@ -0,0 +1,347 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent Inc.
+// SPDX-License-Identifier: GPL-2.0-only
+
+// Optional PCI peer-to-peer memory (p2pmem) for Blackhole.
+//
+// BAR4 of a Blackhole is a window onto the NOC: each 4 GiB TLB window in it is routed,
+// by a TLB register that userspace programs with CONFIGURE_TLB, to an address in one
+// NOC endpoint (a DRAM bank, say).  Publishing (part of) BAR4 as p2pmem gives that
+// range struct pages, so the kernel's own peer-to-peer machinery can DMA into it: a
+// userspace process mmaps /sys/bus/pci/devices/<bdf>/p2pmem/allocate (Linux 6.2+) and
+// O_DIRECT-reads a file from an NVMe drive into the mapping, and the drive writes the
+// data to the card without it passing through host RAM.
+//
+// This file only publishes the memory.  It programs no TLB: whoever uses the memory
+// must own a TLB window that covers it (ALLOCATE_TLB + CONFIGURE_TLB) for as long as
+// the mapping exists.  A window that is unconfigured, or reconfigured while a DMA is in
+// flight, sends the data wherever the NOC is told to send it.
+//
+// OFF by default: nothing is published unless the p2pmem_devices module parameter
+// names the device.
+
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/pci.h>
+#include <linux/slab.h>
+#include <linux/sizes.h>
+#include <linux/string.h>
+#include <linux/device.h>
+#include <linux/sysfs.h>
+#include <linux/version.h>
+
+#if IS_ENABLED(CONFIG_PCI_P2PDMA)
+#include <linux/pci-p2pdma.h>
+#endif
+
+#include "device.h"
+#include "module.h"
+#include "p2pmem.h"
+#include "tlb.h"
+
+// BAR4 is the Blackhole 4 GiB-window aperture.  BAR0 holds the TLB registers and the
+// 2 MiB windows onto device registers, which are not memory, so it is never offered.
+#define TT_P2PMEM_BAR 4
+
+static char p2pmem_devices[256];
+module_param_string(p2pmem_devices, p2pmem_devices, sizeof(p2pmem_devices), 0444);
+MODULE_PARM_DESC(p2pmem_devices,
+		 "Blackhole devices whose BAR4 slice is published as PCI peer-to-peer memory: "
+		 "a comma-separated list of PCI addresses (0000:41:00.0,0000:42:00.0) or \"all\". "
+		 "Empty (the default) publishes nothing.");
+
+static ulong p2pmem_offset_mb;
+module_param(p2pmem_offset_mb, ulong, 0444);
+MODULE_PARM_DESC(p2pmem_offset_mb,
+		 "Offset of the published slice inside BAR4, in MiB (even; default 0). "
+		 "TLB window k of 4 GiB starts at 4096 * k.");
+
+static ulong p2pmem_size_mb = 4096;
+module_param(p2pmem_size_mb, ulong, 0444);
+MODULE_PARM_DESC(p2pmem_size_mb,
+		 "Size of the published slice, in MiB (even; default 4096, one 4 GiB window). "
+		 "The kernel spends 64 bytes of host RAM per 4 KiB page of it.");
+
+static bool p2pmem_publish;
+module_param(p2pmem_publish, bool, 0444);
+MODULE_PARM_DESC(p2pmem_publish,
+		 "Also call pci_p2pmem_publish() so that in-kernel orchestrators (nvmet) may pick "
+		 "the memory on their own (default off). Userspace allocation through "
+		 "p2pmem/allocate does not need it.");
+
+#if IS_ENABLED(CONFIG_PCI_P2PDMA)
+
+static bool p2pmem_wanted(struct pci_dev *pdev)
+{
+	char *list, *cursor, *token;
+	bool wanted = false;
+
+	if (!p2pmem_devices[0])
+		return false;
+
+	list = kstrdup(p2pmem_devices, GFP_KERNEL);
+	if (!list)
+		return false;
+
+	cursor = list;
+	while ((token = strsep(&cursor, ",; \t\n")) != NULL) {
+		token = strim(token);
+		if (!*token)
+			continue;
+		// Both 0000:41:00.0 and 41:00.0 (domain 0) name a device.
+		if (!strcasecmp(token, "all") || !strcasecmp(token, pci_name(pdev)) ||
+		    (strlen(token) == 7 && !strcasecmp(token, pci_name(pdev) + 5))) {
+			wanted = true;
+			break;
+		}
+	}
+
+	kfree(list);
+	return wanted;
+}
+
+static ssize_t bar_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct tenstorrent_device *tt_dev = dev_get_drvdata(dev);
+
+	return scnprintf(buf, PAGE_SIZE, "%d\n", tt_dev->p2pmem.bar);
+}
+static DEVICE_ATTR(bar, 0400, bar_show, NULL);
+
+static ssize_t offset_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct tenstorrent_device *tt_dev = dev_get_drvdata(dev);
+
+	return scnprintf(buf, PAGE_SIZE, "%llu\n", tt_dev->p2pmem.offset);
+}
+static DEVICE_ATTR(offset, 0400, offset_show, NULL);
+
+static ssize_t size_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct tenstorrent_device *tt_dev = dev_get_drvdata(dev);
+
+	return scnprintf(buf, PAGE_SIZE, "%llu\n", tt_dev->p2pmem.size);
+}
+static DEVICE_ATTR(size, 0400, size_show, NULL);
+
+static ssize_t bus_addr_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct tenstorrent_device *tt_dev = dev_get_drvdata(dev);
+
+	return scnprintf(buf, PAGE_SIZE, "0x%llx\n", tt_dev->p2pmem.bus_addr);
+}
+static DEVICE_ATTR(bus_addr, 0400, bus_addr_show, NULL);
+
+static ssize_t tlb_first_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct tenstorrent_device *tt_dev = dev_get_drvdata(dev);
+
+	return scnprintf(buf, PAGE_SIZE, "%d\n", tt_dev->p2pmem.tlb_first);
+}
+static DEVICE_ATTR(tlb_first, 0400, tlb_first_show, NULL);
+
+static ssize_t tlb_last_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct tenstorrent_device *tt_dev = dev_get_drvdata(dev);
+
+	return scnprintf(buf, PAGE_SIZE, "%d\n", tt_dev->p2pmem.tlb_last);
+}
+static DEVICE_ATTR(tlb_last, 0400, tlb_last_show, NULL);
+
+static struct attribute *tt_p2pmem_attrs[] = {
+	&dev_attr_bar.attr,
+	&dev_attr_offset.attr,
+	&dev_attr_size.attr,
+	&dev_attr_bus_addr.attr,
+	&dev_attr_tlb_first.attr,
+	&dev_attr_tlb_last.attr,
+	NULL,
+};
+
+static const struct attribute_group tt_p2pmem_group = {
+	.name = "p2pmem",
+	.attrs = tt_p2pmem_attrs,
+};
+
+// Which inbound TLB windows route traffic that lands in [offset, offset + size) of the BAR.
+static void p2pmem_find_tlbs(struct tenstorrent_device *tt_dev, struct tt_p2pmem *p)
+{
+	int id;
+
+	if (!tt_dev->dev_class->describe_tlb)
+		return;
+
+	for (id = 0; id < TENSTORRENT_MAX_INBOUND_TLBS; id++) {
+		struct tlb_descriptor desc = { 0 };
+
+		if (tt_dev->dev_class->describe_tlb(tt_dev, id, &desc))
+			continue;
+		if (desc.bar != p->bar)
+			continue;
+		if (desc.bar_offset + desc.size <= p->offset || desc.bar_offset >= p->offset + p->size)
+			continue;
+
+		if (p->tlb_first < 0)
+			p->tlb_first = id;
+		p->tlb_last = id;
+	}
+}
+
+void tt_p2pmem_probe(struct tenstorrent_device *tt_dev)
+{
+	struct tt_p2pmem *p = &tt_dev->p2pmem;
+	struct pci_dev *pdev = tt_dev->pdev;
+	resource_size_t bar_len;
+	u64 offset, size;
+	int ret;
+
+	p->bar = TT_P2PMEM_BAR;
+	p->tlb_first = -1;
+	p->tlb_last = -1;
+
+	if (!p2pmem_wanted(pdev))
+		return;
+
+	if (tt_dev->dev_class != &blackhole_class) {
+		dev_warn(&pdev->dev, "p2pmem: only Blackhole devices can publish p2pmem; not publishing\n");
+		return;
+	}
+
+	if (p2pmem_offset_mb >= BIT(30) || p2pmem_size_mb >= BIT(30)) {
+		dev_warn(&pdev->dev, "p2pmem: offset or size is out of range; not publishing\n");
+		return;
+	}
+
+	offset = (u64)p2pmem_offset_mb << 20;
+	size = (u64)p2pmem_size_mb << 20;
+
+	// The pages are created in whole 2 MiB sub-sections.
+	if (!size || (offset | size) & (SZ_2M - 1)) {
+		dev_warn(&pdev->dev,
+			 "p2pmem: offset %llu and size %llu bytes must be non-zero multiples of 2 MiB; not publishing\n",
+			 offset, size);
+		return;
+	}
+
+	bar_len = pci_resource_len(pdev, TT_P2PMEM_BAR);
+	if (offset >= bar_len || size > bar_len - offset) {
+		dev_warn(&pdev->dev,
+			 "p2pmem: slice [%llu, +%llu) does not fit in BAR%d (%llu bytes); not publishing\n",
+			 offset, size, TT_P2PMEM_BAR, (u64)bar_len);
+		return;
+	}
+
+	ret = pci_p2pdma_add_resource(pdev, TT_P2PMEM_BAR, size, offset);
+	if (ret) {
+		dev_warn(&pdev->dev, "p2pmem: pci_p2pdma_add_resource failed (%d); not publishing\n", ret);
+		return;
+	}
+
+	p->offset = offset;
+	p->size = size;
+	p->bus_addr = pci_bus_address(pdev, TT_P2PMEM_BAR) + offset;
+	p2pmem_find_tlbs(tt_dev, p);
+	smp_store_release(&p->published, true);
+
+	if (p2pmem_publish)
+		pci_p2pmem_publish(pdev, true);
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 2, 0)
+	dev_warn(&pdev->dev, "p2pmem: this kernel has no p2pmem/allocate (Linux 6.2 or later); only in-kernel users can use the memory\n");
+#endif
+
+	ret = device_add_group(&tt_dev->dev, &tt_p2pmem_group);
+	if (ret)
+		dev_warn(&pdev->dev, "p2pmem: sysfs group not created (%d)\n", ret);
+	else
+		p->group_registered = true;
+
+	dev_info(&pdev->dev,
+		 "p2pmem: BAR%d [%#llx, +%#llx) is peer-to-peer memory (TLB windows %d..%d), %s; "
+		 "the user must own and configure those windows\n",
+		 TT_P2PMEM_BAR, offset, size, p->tlb_first, p->tlb_last,
+		 p2pmem_publish ? "published for in-kernel users" : "for userspace allocation only");
+}
+
+void tt_p2pmem_remove(struct tenstorrent_device *tt_dev)
+{
+	struct tt_p2pmem *p = &tt_dev->p2pmem;
+
+	if (p->group_registered) {
+		device_remove_group(&tt_dev->dev, &tt_p2pmem_group);
+		p->group_registered = false;
+	}
+
+	// The PCI core unmaps the userspace mappings and waits for the pages only when the driver
+	// has finished unbinding, after this driver has stopped the card; it offers no way to revoke
+	// them sooner. Nothing may be allocated when a device is removed or the module unloaded.
+	if (p->published && tt_p2pmem_busy(tt_dev))
+		dev_warn(&tt_dev->pdev->dev,
+			 "p2pmem: removing a device whose p2pmem is still allocated; a DMA into it may be in flight\n");
+
+	smp_store_release(&p->published, false);
+}
+
+// The pool is the one slice, so it can be allocated whole exactly when nothing else holds
+// any of it. Allocating it is the only way to ask, and to keep anyone else out, without
+// reaching into the PCI core's private state. The pool's bits stay set until the last
+// page reference is dropped, so a mapping, a pinned page and a bio in flight all count.
+int tt_p2pmem_hold(struct tenstorrent_device *tt_dev, void **cookie)
+{
+	struct tt_p2pmem *p = &tt_dev->p2pmem;
+
+	*cookie = NULL;
+
+	if (!smp_load_acquire(&p->published))
+		return 0;
+
+	*cookie = pci_alloc_p2pmem(tt_dev->pdev, p->size);
+	return *cookie ? 0 : -EBUSY;
+}
+
+void tt_p2pmem_release(struct tenstorrent_device *tt_dev, void *cookie)
+{
+	if (cookie)
+		pci_free_p2pmem(tt_dev->pdev, cookie, tt_dev->p2pmem.size);
+}
+
+bool tt_p2pmem_busy(struct tenstorrent_device *tt_dev)
+{
+	void *cookie;
+
+	if (tt_p2pmem_hold(tt_dev, &cookie))
+		return true;
+
+	tt_p2pmem_release(tt_dev, cookie);
+	return false;
+}
+
+#else /* !CONFIG_PCI_P2PDMA */
+
+void tt_p2pmem_probe(struct tenstorrent_device *tt_dev)
+{
+	if (p2pmem_devices[0])
+		dev_warn(&tt_dev->pdev->dev, "p2pmem: this kernel was built without CONFIG_PCI_P2PDMA; not publishing\n");
+}
+
+void tt_p2pmem_remove(struct tenstorrent_device *tt_dev)
+{
+}
+
+int tt_p2pmem_hold(struct tenstorrent_device *tt_dev, void **cookie)
+{
+	*cookie = NULL;
+	return 0;
+}
+
+void tt_p2pmem_release(struct tenstorrent_device *tt_dev, void *cookie)
+{
+}
+
+bool tt_p2pmem_busy(struct tenstorrent_device *tt_dev)
+{
+	return false;
+}
+
+#endif
